# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit real credentials.

# Orders database — Firebase (Firestore). Same project the storefront
# (skinwise-ecommerce) writes orders into. Get these from the Firebase
# Console: Project settings > Service accounts > Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the "private_key" value from that JSON as-is, including the
# -----BEGIN PRIVATE KEY----- header and quotes around it.
FIREBASE_PRIVATE_KEY=

# Who's allowed into the admin panel, regardless of how they sign in.
# Comma-separated if more than one person needs access.
ADMIN_ALLOWED_EMAILS=

# Firebase Auth — client-side config (safe to expose to the browser). From
# Firebase Console > Project settings > General > Your apps > Web app
# (add one if it doesn't exist yet).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Resend — sends order-confirmation and status-update emails.
RESEND_API_KEY=
ORDERS_FROM_EMAIL=orders@skinwiseshop.in
